// Cloudflare deployment — Workers Static Assets (free tier, recommended
// over Pages for new projects). `npx wrangler deploy` runs the build
// below automatically, then publishes dist/ at
// https://s1-landingpage.<your-subdomain>.workers.dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s1-landingpage",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  }
}
